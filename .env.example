# ThreatLens reads only these environment variables. Nothing here is a secret.
#
# Path to config.toml (default: %LOCALAPPDATA%\ThreatLens\config.toml)
THREATLENS_CONFIG=
# Overrides [general].log_level (DEBUG, INFO, WARNING, ERROR)
THREATLENS_LOG_LEVEL=
# Set to any value to disable colour output (https://no-color.org)
NO_COLOR=
